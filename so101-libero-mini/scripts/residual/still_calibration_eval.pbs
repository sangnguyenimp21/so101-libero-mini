#!/bin/bash
#PBS -N still_calibration
#PBS -P personal-e1638612
#PBS -l select=1:ncpus=8:mpiprocs=1:ompthreads=8:ngpus=1
#PBS -l walltime=06:00:00
#PBS -j oe
#PBS -o /scratch/e1638612/so101-libero-mini/docs/residual/results/calibration/still_calibration.log
set -euo pipefail
cd /scratch/e1638612/so101-libero-mini
source /scratch/e1638612/miniforge3/bin/activate
conda activate so101lm
export MUJOCO_GL=egl PYTHONPATH=. OMP_NUM_THREADS=2
python -u scripts/residual/evaluate_still_calibration.py
python - <<'PY'
import json
from pathlib import Path
root=Path('docs/residual/results/calibration')
s=json.loads((root/'still_calibration_results.json').read_text())['summary']
with Path('docs/residual/NOTES.md').open('a') as f:
 f.write('\n### Non-learning first-still-moment calibration result\n\n')
 f.write(f"- Frozen test at L*={s['Lstar_deg']} degrees: {s['successes']}/{s['episodes']}; Wilson 95% {s['wilson95']}. SmolVLA alone: {s['baseline_successes']}/{s['episodes']}.\n")
 f.write(f"- Paired fixed={s['fixed']}, broken={s['broken']}, exact two-sided McNemar p={s['mcnemar_exact_two_sided_p']}. Failures: {s['failure_types']}.\n")
 f.write(f"- Bias estimated in {s['estimated_episodes']}/{s['episodes']} episodes; mean absolute estimation error by arm joint (degrees): {s['mean_abs_bias_estimation_error_deg']}.\n")
PY
flock /tmp/so101_residual_git.lock bash -c 'git add docs/residual/NOTES.md docs/residual/results/calibration/still_calibration_results.json && git commit -m "residual: record non-learning calibration test"'
