# Site settings of the three-cube SmolVLA jobs (slurm/train_{flip,sort,pyramid,stack,green_right,multitask}_h100.sbatch).
# The driver (slurm/three_cubes_job.sbatch) sources this file; anything already set in the environment wins, e.g.
#     BATCH_SIZE=64 sbatch slurm/train_flip_h100.sbatch
# Account / partition / time: on the command line (sbatch --account=<acct> --partition=<part> --time=30:00:00 ...),
# or SBATCH_ACCOUNT / SBATCH_PARTITION / SBATCH_TIMELIMIT exported in the submitting shell.

# Shared directory of all nodes: datasets ($SCRATCH_ROOT/datasets/lerobot/<repo id>), Hugging Face cache, OSMesa.
: "${SCRATCH_ROOT:=$HOME/so101lm}"
# Runtime: the conda env made by scripts/setup_conda_env.sh (lerobot[smolvla] 0.4.2, transformers 4.57.6, mujoco
# 3.3.7, OSMesa, smolvla_base); the first job creates it (~15 min, needs internet on the node).
: "${ENV_NAME:=so101lm}"
: "${CONDA_ROOT:=$HOME/miniconda3}"

# Training (scripts/train_smolvla_task.sh): every run starts from lerobot/smolvla_base, 80k optimizer steps, checkpoints
# every 20k (020000 040000 060000 080000), cosine LR decay over the 80k steps, BF16, one H100 96 GB to itself.
# SmolVLA training memory measured on this project (bf16, frozen VLM): ~1.3 GB + ~0.18 GB per sample, i.e. batch 128
# ~25 GB, 256 ~48 GB, 384 ~71 GB. A bigger batch uses the GPU better but makes each step longer, and the step count is
# fixed at 80k: 128 is 4x the samples of the batch-32 recipe; BATCH_SIZE=64 or 32 finishes sooner.
: "${BATCH_SIZE:=128}"
: "${STEPS:=80000}"
: "${SAVE_FREQ:=20000}"
: "${PRECISION:=bf16}"
: "${SEED:=1000}"
: "${NUM_WORKERS:=16}"     # DataLoader workers decoding the AV1 videos (the jobs ask for 32 CPUs)
: "${GPU_MEM_GB:=90}"      # the training process logs its peak GPU memory (and stays below this, GB)
: "${WANDB:=false}"        # true: log to Weights & Biases (WANDB_PROJECT, WANDB_ENTITY, credentials in ~/.netrc)

# Datasets: a complete dataset is used as is (e.g. copied from the machine that made it), else generated in the job
# (100 demonstrations, 20 per layout, replay-validated; ~10-25 min). The multitask job merges the three task datasets.
: "${GEN_WORKERS:=16}"

# Evaluation of every checkpoint with the full episode controller (scripts/eval_task.sh): 25 frozen start states per
# task, each checkpoint as soon as it is saved while training continues on the same GPU (EVAL_DURING_TRAINING=1),
# then any missing one and the summary with BEST. EVAL_RENDER: auto = EGL if tests/egl_cuda_workers_selftest.py passes
# on the node, else OSMesa (CPU).
: "${EVAL_EPISODES:=25}"
: "${EVAL_WORKERS:=8}"
: "${EVAL_VIDEOS:=5}"
: "${EVAL_DEVICE:=cuda}"
: "${EVAL_DURING_TRAINING:=1}"
: "${EVAL_RENDER:=auto}"

export SCRATCH_ROOT ENV_NAME CONDA_ROOT BATCH_SIZE STEPS SAVE_FREQ PRECISION SEED NUM_WORKERS GPU_MEM_GB WANDB \
    GEN_WORKERS EVAL_EPISODES EVAL_WORKERS EVAL_VIDEOS EVAL_DEVICE EVAL_DURING_TRAINING EVAL_RENDER
true
