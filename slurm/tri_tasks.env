# Site settings for the so101_tri SmolVLA jobs
# (slurm/train_smolvla_{cylinder_aside,cube_flip,green_into_tray,multitask}.slurm).
# Every job sources this file; anything already set in the environment wins. Edit the defaults here, or override per
# submission (e.g. BATCH_SIZE=64 sbatch slurm/train_smolvla_cube_flip.slurm).
#
# Slurm account / partition / time: sbatch reads SBATCH_ACCOUNT, SBATCH_PARTITION and SBATCH_TIMELIMIT from the
# submitting shell, and they override the #SBATCH lines in the scripts. So either (in a subshell, so these settings do
# not stay in your login shell, where every job you submit later would inherit them)
#     ( source slurm/tri_tasks.env && sbatch slurm/train_smolvla_cube_flip.slurm )
# (with the two exports below filled in), or pass them on the command line:
#     sbatch --account=<account> --partition=<partition> slurm/train_smolvla_cube_flip.slurm
# export SBATCH_ACCOUNT=<your-account>
# export SBATCH_PARTITION=gpu

# Shared scratch directory (all nodes): datasets in $SCRATCH_ROOT/datasets/lerobot/<repo_id>, HF cache, OSMesa.
: "${SCRATCH_ROOT:=$HOME/so101lm}"
# Environment activation. Default: the conda env ENV_NAME under CONDA_ROOT, created/checked by
# scripts/setup_conda_env.sh (lerobot[smolvla] 0.4.2, transformers 4.57.6, mujoco 3.3.7, smolvla_base weights).
# Set ENV_ACTIVATE to a shell command to use an existing environment instead (setup is skipped), e.g.
#   ENV_ACTIVATE="source $HOME/venvs/lerobot042/bin/activate"
: "${ENV_NAME:=so101lm}"
: "${CONDA_ROOT:=$HOME/miniconda3}"
# : "${ENV_ACTIVATE:=}"

# Pretrained checkpoint to fine-tune (never trained from scratch): a hub id cached in $SCRATCH_ROOT/cache (the jobs run
# with HF_HUB_OFFLINE=1; setup_conda_env.sh caches lerobot/smolvla_base) or a local .../pretrained_model directory.
: "${PRETRAINED:=lerobot/smolvla_base}"

# Datasets (LeRobot repo ids; the data lives in $SCRATCH_ROOT/datasets/lerobot/<repo_id>). A missing per-task dataset
# is generated by the job (20 successful demonstrations per placement x 5 placements; one job at a time per dataset,
# others wait and reuse it); the multitask dataset is merged from the three per-task ones. Data generated on another
# platform (e.g. a Mac) can be copied there instead, but the job's replay validation may then fail (cross-platform
# physics). These ids are new: datasets of the retired tasks (cube_left, green_into_box, cylinder_flip) and the old
# local/so101_tri_multitask_300 are never picked up.
: "${CYLINDER_ASIDE_REPO:=local/so101_tri_cylinder_aside_100}"
: "${CUBE_FLIP_REPO:=local/so101_tri_cube_flip_100}"
: "${GREEN_INTO_TRAY_REPO:=local/so101_tri_green_into_tray_100}"
: "${MULTITASK_REPO:=local/so101_tri_v2_multitask_300}"
: "${GEN_ARGS:=--demos-per-placement 20}"

# Training (lerobot-train 0.4.2 arguments are built by the driver, slurm/smolvla_job.sbatch).
# One H100 96 GB: batch 32 is this project's SmolVLA recipe (~4-5 h for 100k steps); 64 also fits in 96 GB (raise the
# time limit: sbatch --time=20:00:00 ...). One optimizer step per batch (no gradient accumulation in lerobot-train 0.4.2).
: "${BATCH_SIZE:=32}"
: "${STEPS:=100000}"        # optimizer updates
: "${SAVE_FREQ:=20000}"     # checkpoints 020000, 040000, 060000, 080000, 100000 (all kept) + last -> 100000
: "${PRECISION:=bf16}"      # Accelerate mixed precision: bf16 | fp16 | no
: "${NUM_WORKERS:=10}"      # DataLoader workers (video decoding)
: "${SEED:=1000}"
# Evaluation in the simulator after training, on the frozen starts init_states/<task>.json (50 per task: 10 per
# placement): all (every saved checkpoint: 020000 ... 100000, results in $OUT/eval/<step>/results.json) | last | none.
# A resubmission skips checkpoints whose evaluation finished.
: "${EVAL_CKPTS:=all}"
: "${EVAL_EPISODES:=50}"
: "${WANDB:=false}"

export SCRATCH_ROOT ENV_NAME CONDA_ROOT PRETRAINED CYLINDER_ASIDE_REPO CUBE_FLIP_REPO GREEN_INTO_TRAY_REPO \
    MULTITASK_REPO GEN_ARGS BATCH_SIZE STEPS SAVE_FREQ PRECISION NUM_WORKERS SEED EVAL_CKPTS EVAL_EPISODES WANDB
[ -n "${ENV_ACTIVATE:-}" ] && export ENV_ACTIVATE
true
